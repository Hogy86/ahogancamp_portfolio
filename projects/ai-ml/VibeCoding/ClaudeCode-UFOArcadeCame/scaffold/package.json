{
  "name": "vanguard-vs-sentinels",
  "version": "1.0.0",
  "description": "Vanguard vs. Sentinels: Shield Invaders - a browser-based arcade shooter (v1 demo).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "jsdom": "^24.1.3",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
