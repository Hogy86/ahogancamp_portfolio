{
  "name": "vanguard-vs-sentinels",
  "version": "1.0.0",
  "description": "Shield vs Robots - a browser-based arcade shooter (v1 demo). (npm package name kept as-is per F22 AC12 - internal identifiers are not required to change.)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && vite build --mode android",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew assembleDebug",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:mobile": "playwright test -c playwright.mobile.config.ts",
    "check:secrets": "node scripts/check-no-secrets.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.63.0",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "jsdom": "24.1.3",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
